
@{
    ViewBag.Title = "Dashboard";
}

@*<h2>Dashboard</h2>*@
<h1 style="text-align: center; font-size: 32px; font-weight: bold; color: #2c3e50; margin-bottom: 40px;">
    Welcome to your <span style="color: #4CAF50;">Expense Dashboard</span>
</h1>


<div>
    <h2 style="text-align:center;">💰 Total Expenses: @ViewBag.TotalExpense</h2>
</div>

<!-- You can loop over recent expenses -->

<div>
    @*<h3>Recent Expenses</h3>*@
    <h2 style="text-align: center;">📋 Recent Expenses</h2>

    <ul>
        @foreach (var expense in ViewBag.RecentExpenses)
        {
            <li>@expense.Category - @expense.Amount - @expense.Date</li>
        }
    </ul>
</div>

@*<a href="@Url.Action("Create", "Expense")">Add Expense</a>*@


<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #f4f7fa;
        margin: 0;
        padding: 0;
    }

    .dashboard-container {
        max-width: 1100px;
        margin: 40px auto;
        padding: 20px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .dashboard-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .overview {
        display: flex;
        justify-content: space-around;
        margin-bottom: 30px;
    }

    .overview-item {
        background: #4CAF50;
        color: white;
        padding: 20px;
        border-radius: 10px;
        flex: 1;
        margin: 0 10px;
        text-align: center;
        font-size: 1.2rem;
    }

    .expense-table {
        width: 100%;
        border-collapse: collapse;
    }

        .expense-table th, .expense-table td {
            padding: 12px 15px;
            border: 1px solid #ddd;
            text-align: center;
        }

        .expense-table th {
            background-color: #4CAF50;
            color: white;
        }

    .add-expense-btn {
        s display: inline-block;
        margin-top: 20px;
        padding: 10px 20px;
        background: #4CAF50;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        transition: background 0.3s;
    }

        .add-expense-btn:hover {
            background: #45a049;
        }
</style>

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>Expense Tracker Dashboard</h1>
    </div>

    <div class="overview">
        <div class="overview-item">
            <h2>Total Expenses</h2>
            <p>₹@ViewBag.TotalExpense</p>
        </div>

    </div>

    @*<h2>Expense Breakdown by Category</h2>
    <canvas id="expensePieChart" width="400" height="400"></canvas>*@

    <h2>Recent Expenses</h2>
    <table class="expense-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Amount</th>
                <th>Category</th>
                <th>Date</th>
                <th>Actions</th> <!-- 👈 New -->
            </tr>
        </thead>
        <tbody>
            @foreach (var expense in ViewBag.RecentExpenses)
            {
                <tr>
                    <td>@expense.Title</td>
                    <td>₹@expense.Amount</td>
                    <td>@expense.Category</td>
                    <td>@expense.Date.ToShortDateString()</td>
                    <td>
                        <a href="@Url.Action("Edit", "Expense", new { id = expense.Id })"
                           style="color: #2196F3; margin-right: 10px;">Edit</a>

                        <a href="@Url.Action("Delete", "Expense", new { id = expense.Id })"
                           onclick="return confirm('Are you sure you want to delete this expense?');"
                           style="color: #f44336;">Delete</a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div style="text-align: center; margin-top: 30px;">

        <a href="@Url.Action("Create", "Expense")"
           style="padding: 10px 20px; background: #4CAF50; color: white; text-decoration: none; border-radius: 5px; font-size: 16px;">
            + Add New Expense
        </a>
        </div>

    </div>

