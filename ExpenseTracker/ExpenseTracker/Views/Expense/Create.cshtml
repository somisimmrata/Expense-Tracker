
@model ExpenseTracker.Models.Expense

@{
    ViewBag.Title = "Add New Expense";
}

<div style="max-width: 450px; margin: 50px auto; padding: 30px; background-color: #fff; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); font-family: 'Segoe UI', sans-serif;">

    <h2 style="text-align: center; color: #333; margin-bottom: 30px;">Add New Expense</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div style="margin-bottom: 15px;">
            @Html.LabelFor(m => m.Title)
            @Html.TextBoxFor(m => m.Title, new { style = "width:100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" })
        </div>

        <div style="margin-bottom: 15px;">
            @Html.LabelFor(m => m.Amount)
            @Html.TextBoxFor(m => m.Amount, new { type = "number", step = "0.01", style = "width:100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" })
        </div>

        <div style="margin-bottom: 15px;">
            @Html.LabelFor(m => m.Category)
            @Html.DropDownListFor(m => m.Category, new SelectList(
                new List<string> { "Food", "Travel", "Shopping", "Bills", "Other" }
            ), "Select Category", new { style = "width:100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" })
        </div>

        <div style="margin-bottom: 15px;">
            @Html.LabelFor(m => m.Date)
            @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-dd}", new { type = "date", style = "width:100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" })
        </div>

        <button type="submit" style="width:100%; padding: 12px; background-color: #4CAF50; color: white; border: none; border-radius: 5px; font-size: 16px; cursor: pointer;">
            Save Expense
        </button>
    }
</div>


